rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Authenticated dashboard users ─────────────────────────────────────
    // Full read/write on every collection when signed in via Firebase Auth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Public storefront (no auth required) ─────────────────────────────
    // index.html checkout flow writes to these lowercase collections.
    // Create-only; no reads or updates without auth.
    match /orders/{orderId} {
      allow create: if true;
    }
    match /customers/{customerId} {
      allow create: if true;
    }
    match /uploaded_files/{fileId} {
      allow create: if true;
    }
    match /order_tracking/{trackId} {
      allow create: if true;
    }
  }
}
